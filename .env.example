# === 누적 DB (원본, 본교 서버) ===
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=anbu_accum
SOURCE_DB_USER=anbu_ro
SOURCE_DB_PASSWORD=change-me

# === 전송용 DB (원본과 분리) ===
TRANSFER_DB_HOST=127.0.0.1
TRANSFER_DB_PORT=3306
TRANSFER_DB_NAME=anbu_transfer
TRANSFER_DB_USER=anbu_transfer
TRANSFER_DB_PASSWORD=change-me

# === 가명처리 비밀키 (발주기관 전용 보관, 커밋 금지) ===
# 매핑 테이블 암호화 및 비밀키 기반 토큰화에 사용
PSEUDONYM_SECRET_KEY=change-me-use-a-long-random-value
MAPPING_ENCRYPTION_KEY=change-me-32-byte-base64-key

# === MQTT (구독형 전송, TLS) ===
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_TLS_CA=./deploy/certs/ca.crt
MQTT_USERNAME=anbu_publisher
MQTT_PASSWORD=change-me

# === 시각 기준 ===
TZ=Asia/Seoul
