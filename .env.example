# === 데이터베이스 (3개 분리: 누적/전송용/운영) ===
# 개발·테스트 기본값은 sqlite. 운영(다향관 서버)은 MariaDB 3개 DB로 물리 분리.
ACCUM_DB_URL=sqlite:///data/accum.db
TRANSFER_DB_URL=sqlite:///data/transfer.db
OPS_DB_URL=sqlite:///data/ops.db
# 운영 예시:
# ACCUM_DB_URL=mysql+pymysql://anbu_accum:***@127.0.0.1:3306/anbu_accum?charset=utf8mb4
# TRANSFER_DB_URL=mysql+pymysql://anbu_transfer:***@127.0.0.1:3306/anbu_transfer?charset=utf8mb4
# OPS_DB_URL=mysql+pymysql://anbu_ops:***@127.0.0.1:3306/anbu_ops?charset=utf8mb4

# === 가명처리 비밀키 (발주기관 전용 보관 — 절대 커밋 금지, SFR-004) ===
PSEUDONYM_SECRET_KEY=change-me-use-a-long-random-value
# Fernet 키(urlsafe base64 32바이트). 비우면 PSEUDONYM_SECRET_KEY에서 유도.
MAPPING_ENCRYPTION_KEY=

# === MQTT 구독형 전송 (SFR-006) ===
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_TLS_CA=./deploy/certs/ca.crt
MQTT_USERNAME=anbu_publisher
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=anbu

# === API 인증 (SFR-007) ===
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRE_MINUTES=60

# === ETL (SFR-002) ===
LIGHTING_GAP_THRESHOLD_SEC=60   # 로그 공백이 이 값 이상이면 소등으로 판정
RETENTION_RAW_LOG_DAYS=365      # LED 원시 로그 보관 일수(경과분 파기)
INACTIVE_AFTER_HOURS=48         # 무신호 지속 시 장비 '비활성' 판정 기준

# === 시각 기준 (KST 통일, SFR-002) ===
TZ=Asia/Seoul
